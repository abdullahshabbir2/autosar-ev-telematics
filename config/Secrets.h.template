/**
 * @file    Secrets.h.template
 * @brief   Template for the git-ignored credentials header.
 *
 * Copy this file to `config/Secrets.h` and fill it in. `config/Secrets.h` is listed in `.gitignore` and
 * must never be committed.
 *
 *     cp config/Secrets.h.template config/Secrets.h
 *     # then edit config/Secrets.h
 *
 * @par Why this file exists
 * v1 committed a Firebase authentication token and a WiFi password as string literals in
 * `include/config.h`:
 *
 *     #define DEFAULT_PASSWORD  "..."
 *     #define FIREBASE_AUTH     "..."
 *
 * Both are in that repository's history permanently -- removing them from the current revision does not
 * remove them from the history -- and anyone with read access to the source had write access to the
 * fleet's database. Any credential that was ever committed must be treated as compromised and rotated;
 * see @ref docs/09-operations.md.
 *
 * @par What belongs here, and what does not
 * Only credentials and endpoints that differ between deployments. Anything a reader would want to know to
 * understand the firmware belongs in `Ecu_Cfg.h`, which is committed. In particular the *device
 * identifier* is not here: it is provisioned per unit into NvM at manufacture, so one firmware image
 * serves the whole fleet.
 *
 * @par A note on what this does and does not achieve
 * Keeping credentials out of version control stops them leaking through the repository. It does not
 * protect them on the device: they are compiled into the image, and anyone with physical access can read
 * the flash. Genuinely protecting them needs ESP32 flash encryption and secure boot, which
 * @ref docs/04-safety-analysis.md records as an accepted open risk with the reasoning.
 *
 * @copyright
 * Copyright (c) 2024-2026 Abdullah Shabbir. All rights reserved.
 * SPDX-License-Identifier: Proprietary
 */

#ifndef SECRETS_H
#define SECRETS_H

/*==================================================================================================
 *  WiFi
 *
 *  Up to SECRETS_WIFI_AP_COUNT access points, tried in order. A vehicle typically has a depot network and
 *  a workshop network.
 *================================================================================================*/

#define SECRETS_WIFI_AP_COUNT 2u

#define SECRETS_WIFI_SSID_1 "depot-network"
#define SECRETS_WIFI_PASSWORD_1 "REPLACE_ME"

#define SECRETS_WIFI_SSID_2 "workshop-network"
#define SECRETS_WIFI_PASSWORD_2 "REPLACE_ME"

/*==================================================================================================
 *  Cellular
 *================================================================================================*/

/** GPRS access point name for the fitted SIM. */
#define SECRETS_GPRS_APN "internet"

/** GPRS username. Empty for most operators. */
#define SECRETS_GPRS_USER ""

/** GPRS password. Empty for most operators. */
#define SECRETS_GPRS_PASSWORD ""

/** SIM PIN. Empty if the SIM has none, which is the expected configuration for a fleet. */
#define SECRETS_SIM_PIN ""

/*==================================================================================================
 *  MQTT broker
 *
 *  These are the fallback values, used only until a unit is provisioned: the broker address and port are
 *  stored per unit in NvM and can be changed remotely without a firmware update.
 *================================================================================================*/

#define SECRETS_MQTT_HOST "broker.example.com"
#define SECRETS_MQTT_PORT 1883u

/** Broker username. Empty for an unauthenticated broker. */
#define SECRETS_MQTT_USER ""

/** Broker password. */
#define SECRETS_MQTT_PASSWORD ""

/*==================================================================================================
 *  OTA update server
 *================================================================================================*/

/** Base URL firmware images are fetched from. */
#define SECRETS_OTA_URL_BASE "https://ota.example.com/firmware/"

/**
 * @brief Shared secret used to authenticate an OTA image.
 *
 * The image's HMAC-SHA256 is verified against this before the new slot is marked bootable, so an image
 * from anywhere other than the update server is rejected. A shared secret is weaker than image signing
 * with an asymmetric key -- every unit holds the same secret, so extracting it from one compromises the
 * fleet's update path -- and that limitation is recorded as an accepted risk in
 * @ref docs/04-safety-analysis.md rather than left unstated.
 */
#define SECRETS_OTA_HMAC_KEY "REPLACE_ME_WITH_32_BYTES_OF_RANDOM"

#endif /* SECRETS_H */
